# Rust build artifacts
/target/
.claude/worktrees/

# cargo-fuzz outputs
/hazelcast-client-core/fuzz/target/
/hazelcast-client-core/fuzz/corpus/
/hazelcast-client-core/fuzz/artifacts/

# Python bytecode (bench scripts)
__pycache__/

# Local benchmark scratch space
/.benchwork/

# Benchmark run outputs + Java build dirs (regenerable; not source)
/benchmarks/out_*/
/bench-java/build/
/bench-java/.gradle/
/bench/manifest.t2.json
/benchmarks/headline/
/benchmarks/t0/
/benchmarks/out_t0smoke/
# Raw per-run records from the head-to-head runs; only provenance.json is kept
/benchmarks/h2h*/*
!/benchmarks/h2h*/provenance.json
